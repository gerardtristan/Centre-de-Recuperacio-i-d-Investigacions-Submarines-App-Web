# Copia aquest fitxer a .env i omple-hi els valors. El .env mai va al repositori.

# Clau de Django. Genera'n una: python -c "import secrets; print(secrets.token_urlsafe(50))"
DJANGO_SECRET_KEY=

# Clau de xifratge dels secrets TOTP (Fernet). Genera'n una:
# python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
# Per canviar-la, posa la nova al davant separada per una coma i conserva l'antiga.
FIELD_ENCRYPTION_KEYS=

# Claus del QR del carnet (decisió 079): «identificador:clau» separades per comes, i quina es fa
# servir per emetre. L'identificador té d'1 a 8 lletres minúscules o xifres; la clau, 32 caràcters
# o més. Genera'n una: python -c "import secrets; print(secrets.token_urlsafe(48))"
# En local es poden deixar buides (se'n deriva una de la clau de Django). A producció són
# obligatòries (checklist C12). Per rotar (079, A-01): afegeix la nova, posa-la com a activa i
# conserva l'antiga mentre hi hagi carnets emesos amb ella. Si una clau s'ha filtrat: afegeix-ne
# una de nova com a activa, executa `python manage.py reemet_carnets --clau <identificador>
# --motiu "..."` i després treu la vella.
# CARD_QR_KEYS=k1:CLAU
# CARD_QR_ACTIVE_KEY=k1

# Claus de l'IBAN del mandat SEPA (decisió 044): «versió:clau Fernet» separades per comes; xifra la
# de versió més alta i cada IBAN es llegeix amb la clau de la seva versió. Sense cap clau no es pot
# desar cap mandat (tampoc en local). Genera'n una:
# python -c "from cryptography.fernet import Fernet; print('1:' + Fernet.generate_key().decode())"
# Obligatòria a producció. Per rotar (checklist C13): afegeix la nova amb una versió més alta,
# executa `python manage.py rota_clau_mandats` i
# treu la vella quan cap mandat no la faci servir; guarda'n la còpia fora del servidor mentre hi
# hagi còpies de la base de dades xifrades amb ella.
# MANDATE_ENCRYPTION_KEYS=1:CLAU

# Contrasenya del PostgreSQL local (docker-compose.yml). Tria'n una.
POSTGRES_PASSWORD=

# La mateixa contrasenya, dins l'URL de connexió.
DATABASE_URL=postgres://cris:CONTRASENYA@localhost:5432/cris

# Correu. En local, sense res més, va a la bústia de proves (Mailpit, port 1025): vegeu el
# README. Mai credencials reals de Brevo ni de Scaleway fora de producció (decisió 010).
# A producció són obligatòries EMAIL_HOST, EMAIL_HOST_USER i EMAIL_HOST_PASSWORD.
# EMAIL_HOST=localhost
# EMAIL_PORT=1025
# EMAIL_HOST_USER=
# EMAIL_HOST_PASSWORD=
# EMAIL_USE_TLS=false
# EMAIL_FROM_TRANSACCIONAL=C.R.I.S. <cris@cris.es>
# EMAIL_REPLY_TO=cris@cris.es
# EMAIL_MAX_ATTEMPTS=5
# Límit diari de correus (T-M00-06): amb el límit ple, els correus queden ajornats i surten
# l'endemà. La reserva és la part que el butlletí no pot gastar. Un sol avís al dia en arribar
# al percentatge; EMAIL_ALERT_TO és l'adreça de l'administrador, l'únic que el rep (decisió 081,
# punt 21). A producció, si no es defineix, és cris@cris.es (decisió 084; config/settings/prod.py).
# En local i a les proves no té valor per defecte: l'avís només queda al registre d'activitat, i
# no s'hi ha de posar l'adreça real.
# EMAIL_DAILY_LIMIT=300
# EMAIL_TRANSACTIONAL_RESERVE=100
# EMAIL_ALERT_THRESHOLD_PCT=80
# EMAIL_ALERT_TO=

# Seguiment d'errors (E4): només el llegeix la configuració de producció. Sense DSN no s'activa;
# amb DSN, ha de ser https i el host ha de ser a la llista del codi (apps/core/error_tracking.py,
# P-294); no hi ha cap variable per afegir-n'hi.
# ERROR_TRACKING_DSN=
# ERROR_TRACKING_ENVIRONMENT=production

# Opcionals
# DJANGO_DEBUG=true
# DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
# DJANGO_CSRF_TRUSTED_ORIGINS=https://cris1954.cat
# ADMIN_URL_PATH=gestio
# TOTP_ISSUER_NAME=C.R.I.S.
# PUBLIC_SITE_URL=http://localhost:8000
# DJANGO_NUM_PROXIES=0

# Pagaments (decisió 043). Buit: no es pot cobrar res. En local, el valor per defecte és «fake»
# (proveïdor fals, sense xarxa). PAYMENTS_ENVIRONMENT: «sandbox» o «live».
# Amb la configuració de producció o l'entorn «live», «fake» no deixa arrencar l'aplicació (092).
# PAYMENTS_LIVE_CHARGES_ALLOWED només es posa a true al nivell 2 de producció, amb l'autorització
# de la junta (decisió 025).
# PAYMENTS_PROVIDER=
# PAYMENTS_ENVIRONMENT=sandbox
# PAYMENTS_LIVE_CHARGES_ALLOWED=false
# Cobrament automàtic amb la targeta guardada (T-M05b-15): apagat fins que hi hagi el proveïdor
# real verificat (P-44, P-45). Apagat, la tasca diària no fa res.
# SAVED_CARD_AUTO_CHARGE_ENABLED=false

# Prefix de les referències de transferència (RN-T20): d'1 a 12 majúscules o xifres.
# TRANSFER_REFERENCE_PREFIX=CRIS
# IBAN del club per pagar per transferència (VC-09). Buit: la transferència no s'ofereix.
# CLUB_IBAN_TRANSFERENCIES=
# Pantalles «En construcció» (T-DX-03): encès en local i a l'entorn de proves; mai a producció (P-90).
# SHOW_UNDER_CONSTRUCTION=false
