# Copia aquest fitxer a .env i omple-hi els valors. El .env mai va al repositori.

# Clau de Django. Genera'n una: python -c "import secrets; print(secrets.token_urlsafe(50))"
DJANGO_SECRET_KEY=

# Clau de xifratge dels secrets TOTP (Fernet). Genera'n una:
# python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
# Per canviar-la, posa la nova al davant separada per una coma i conserva l'antiga.
FIELD_ENCRYPTION_KEYS=

# Contrasenya del PostgreSQL local (docker-compose.yml). Tria'n una.
POSTGRES_PASSWORD=

# La mateixa contrasenya, dins l'URL de connexió.
DATABASE_URL=postgres://cris:CONTRASENYA@localhost:5432/cris

# Opcionals
# DJANGO_DEBUG=true
# DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
# DJANGO_CSRF_TRUSTED_ORIGINS=https://cris1954.cat
# ADMIN_URL_PATH=gestio
# TOTP_ISSUER_NAME=C.R.I.S.
# DJANGO_NUM_PROXIES=0
